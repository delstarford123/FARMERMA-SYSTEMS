{
  "rules": {
    "users": {
      // 1. Admin & Tutor Hub: Admins and Tutors can read the user list to manage students
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor')",
      
      "$uid": {
        // Users can read their own profile
        ".read": "auth != null && $uid === auth.uid",
        
        // 2. Security Lock: 
        // Admins can write anything. 
        // Users can write to their own profile, BUT cannot hack their 'role' or 'subscription_tier'.
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || ($uid === auth.uid && (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val()) && (!newData.hasChild('subscription_tier') || newData.child('subscription_tier').val() === data.child('subscription_tier').val())))"
      }
    },

    "academy_courses": {
      // 3. Academy Courses: Paid Tiers and Educators can view
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'pro' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'premium' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'enterprise' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'harvest' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'growth')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor')"
    },

    "training_content": {
      // 4. Legacy/Admin Academy Content
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'pro' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'premium' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'enterprise' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'harvest')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor')"
    },

    "user_progress": {
      // 5. Student Progress Tracking
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor')",
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "market_data": {
      // 6. Live Markets Data Lock
      // ZimBot specific tiers (Seed/Growth/Harvest) added here
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'pro' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'premium' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'harvest' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'growth' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'seed')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "banking_accounts": {
      // 7. Personal Banking Details
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "banking_loans": {
      // 8. Loan Management
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "banking_groups": {
      // 9. Public Group Discovery
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "site_content": {
      // 10. CMS Content
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "completed_transactions": {
      // 11. Billing History
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "pending_registrations": {
      // 12. WhatsApp Onboarding
      ".write": true,
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "pending_payments": {
      // 13. WhatsApp Payment Flow
      ".write": true,
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "pending_transactions": {
      // 14. Checkout Handshake
      ".write": "auth != null",
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "contact_inquiries": {
      // 15. Support Inbox
      ".write": true,
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "climate_alerts": {
      // 16. Localized Alerts
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "pesapal_ipns": {
      // 17. System IPN Cache
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "diagnostic_history": {
      // 18. AI Scans
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    }
  }
}
