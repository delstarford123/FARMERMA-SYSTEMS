{
  "rules": {
    // 0. GLOBAL SECURITY: Deny by default
    ".read": false,
    ".write": false,

    // ==========================================
    // 1. CORE AGRICULTURAL SYSTEM (ZIMBOT)
    // ==========================================
    
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor')",
      ".indexOn": ["email", "phone", "role", "subscription_tier", "created_at", "is_online"],
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || ($uid === auth.uid && (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val()) && (!newData.hasChild('subscription_tier') || newData.child('subscription_tier').val() === data.child('subscription_tier').val())))"
      }
    },

    "market_data": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'pro' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'premium' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'harvest' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'growth' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'seed')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["commodity", "region", "market", "timestamp", "country"]
    },

    "whatsapp_whitelist": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["phone", "added_at"]
    },

    "academy_courses": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'pro' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'premium' || root.child('users').child(auth.uid).child('subscription_tier').val() === 'harvest')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'tutor')",
      ".indexOn": ["category", "difficulty", "tutor_id"]
    },

    "completed_transactions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["user_id", "timestamp", "plan_id"],
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "pending_transactions": {
      ".write": "auth != null",
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["user_id", "status", "timestamp"]
    },

    "climate_alerts": {
      ".indexOn": ["region", "timestamp", "severity"],
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    // ==========================================
    // 2. PROFESSIONAL FEATURES & SOCIAL HUB
    // ==========================================

    "merchant_alerts": {
      "$restaurant_id": {
        ".read": true, 
        "$alert_id": {
          "status": {
            ".write": "newData.val() === 'read'"
          }
        }
      }
    },

    "party_participants": {
      ".read": true,
      "$user_id": {
        ".write": "auth != null && auth.uid === $user_id",
        ".indexOn": ["joined_at", "shape_seed"]
      },
      ".indexOn": ["joined_at"]
    },

    "profiles": {
      ".read": "auth != null",
      ".indexOn": [
        "email", "phone", "referral_code", "wingman_code", "is_paid", 
        "is_online", "gender", "daily_streak", "class_code", 
        "created_at", "institution_name", "institution_type", "crush_votes"
      ]
    },
    
    "notifications": {
      "$user_id": {
        ".indexOn": ["status", "timestamp"]
      }
    },
    
    "schedules": {
      ".indexOn": ["user_id"]
    },
    
    "swipes": {
      ".indexOn": ["user_id", "target_id", "timestamp"]
    },
    
    "bookings": {
      ".indexOn": ["restaurant_id", "user_a_id", "user_b_id", "status", "timestamp"]
    },
    
    "restaurants": {
      ".indexOn": ["subscription_active", "email"]
    },
    
    "matches": {
      ".indexOn": ["users"]
    },

    "messages": {
      "$match_id": {
        ".indexOn": ["timestamp"]
      }
    },

    "chats": {
      "$room_id": {
        ".indexOn": ["timestamp"]
      }
    },

    "confessions": {
      ".indexOn": ["timestamp", "score"]
    },

    "missed_connections": {
      ".indexOn": ["timestamp", "upvotes"]
    },

    "gossip": {
      ".indexOn": ["timestamp", "upvotes"]
    },

    "secret_crushes": {
      ".indexOn": ["status", "timestamp"]
    },

    "daily_prompts": {
      ".indexOn": ["date"]
    },

    "prompt_answers": {
      ".indexOn": ["timestamp"]
    },

    "admin_alerts": {
      ".indexOn": ["timestamp"]
    },
    
    "call_requests": {
      ".indexOn": ["timestamp", "status"]
    },
    
    "feedbacks": {
      ".indexOn": ["timestamp", "type"]
    },

    "call_reviews": {
      ".indexOn": ["timestamp", "quality"]
    },

    "admin_audit_logs": {
      ".indexOn": ["timestamp"]
    },

    "active_ads": {
      ".indexOn": ["status"]
    },

    "party_chat": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp_ms"]
    },

    "party_typing": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // ==========================================
    // 3. SYSTEM UTILITIES
    // ==========================================

    "site_content": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "pesapal_ipns": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "diagnostic_history": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    }
  }
}
